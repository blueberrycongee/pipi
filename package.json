{
  "name": "pipi",
  "version": "0.2.6",
  "private": true,
  "description": "A native desktop control surface for coding agents, built with Native Shell (nsh)",
  "type": "module",
  "scripts": {
    "package:macos": "./scripts/package-mac.sh",
    "package:windows": "nsh package . --target windows",
    "package:linux": "nsh package . --target linux",
    "release:macos": "node scripts/release-macos.mjs"
  }
}
