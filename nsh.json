{
  "name": "pipi",
  "id": "dev.pipi.app",
  "version": "0.2.5",
  "build": 1,
  "icon": "icon.png",
  "theme": "theme.json",
  "updater": { "github": "blueberrycongee/pipi" },
  "window": {
    "title": "pipi",
    "defaultSize": { "width": 1180, "height": 780 },
    "titleBar": { "style": "hidden", "height": 44 }
  },
  "tailwind": {
    "fontSize": {
      "2xs": [10, 1.4],
      "xs": [11, 1.45],
      "sm": [12, 1.5],
      "base": [13, 1.54],
      "md": [14, 1.57],
      "lg": [15, 1.47],
      "xl": [17, 1.41],
      "2xl": [20, 1.3],
      "3xl": [26, 1.23]
    },
    "shadow": {
      "popover": "0 0 0 0.5px rgb(0 0 0 / 0.12), 0 12px 36px -8px rgb(0 0 0 / 0.22), 0 3px 10px -2px rgb(0 0 0 / 0.1)",
      "toast": "0 0 0 0.5px rgb(0 0 0 / 0.12)",
      "raised": "0 1px 2px rgb(0 0 0 / 0.05), 0 8px 24px -6px rgb(0 0 0 / 0.1)",
      "composer": "0 0.5px 1px rgb(0 0 0 / 0.03), 0 2px 6px -1px rgb(0 0 0 / 0.04), 0 12px 32px -10px rgb(0 0 0 / 0.09), 0 28px 64px -24px rgb(0 0 0 / 0.08), inset 0 0.5px 0 rgb(255 255 255 / 0.7)",
      "composer-focus": "0 0.5px 1px rgb(0 0 0 / 0.04), 0 3px 8px -1px rgb(0 0 0 / 0.05), 0 16px 40px -10px rgb(0 0 0 / 0.12), 0 32px 72px -24px rgb(0 0 0 / 0.1), inset 0 0.5px 0 rgb(255 255 255 / 0.85)",
      "composer-dark": "0 0.5px 1px rgb(0 0 0 / 0.3), 0 2px 8px -1px rgb(0 0 0 / 0.26), 0 14px 36px -10px rgb(0 0 0 / 0.4), 0 30px 68px -24px rgb(0 0 0 / 0.34), inset 0 0.5px 0 rgb(255 255 255 / 0.08)",
      "composer-dark-focus": "0 0.5px 1px rgb(0 0 0 / 0.34), 0 3px 10px -1px rgb(0 0 0 / 0.3), 0 18px 44px -10px rgb(0 0 0 / 0.48), 0 34px 76px -24px rgb(0 0 0 / 0.4), inset 0 0.5px 0 rgb(255 255 255 / 0.12)",
      "field": "0 1px 2px rgb(0 0 0 / 0.03), 0 4px 12px -4px rgb(0 0 0 / 0.06), inset 0 0.5px 0 rgb(255 255 255 / 0.5)",
      "field-dark": "0 1px 2px rgb(0 0 0 / 0.2), 0 4px 12px -4px rgb(0 0 0 / 0.3), inset 0 0.5px 0 rgb(255 255 255 / 0.06)"
    },
    "ease": {
      "out-quint": [0.22, 1, 0.36, 1],
      "smooth-out": [0.22, 1, 0.36, 1],
      "spring-out": [0.34, 1.22, 0.64, 1],
      "standard": [0.2, 0, 0, 1]
    }
  },
  "capabilities": {
    "process": {
      "execute": [
        "node", "node.exe", "sh",
        "git", "git.exe",
        "where", "where.exe", "cmd", "cmd.exe",
        "powershell", "powershell.exe", "pwsh", "pwsh.exe",
        "zenity", "kdialog",
        "pi", "claude", "codex", "devin", "opencode", "cursor-agent",
        "gemini", "copilot", "grok", "goose", "kimi", "qwen", "dsh",
        "agy_acp_server", "agy", "hermes", "kiro-cli", "kiro", "droid", "amp", "amp-acp",
        "npx", "uvx", "uv", "bun", "osascript", "chmod"
      ],
      "env": [
        "PATH", "HOME", "TMPDIR", "LANG", "LC_ALL",
        "USERPROFILE", "APPDATA", "LOCALAPPDATA", "HOMEDRIVE", "HOMEPATH",
        "COMSPEC", "PATHEXT", "SYSTEMROOT", "SystemRoot", "WINDIR", "SYSTEMDRIVE",
        "TEMP", "TMP", "ProgramFiles", "ProgramFiles(x86)", "ProgramData",
        "NVM_HOME", "NVM_SYMLINK", "VOLTA_HOME", "FNM_DIR", "MISE_DATA_DIR", "MISE_CONFIG_DIR",
        "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME", "XDG_RUNTIME_DIR",
        "DISPLAY", "WAYLAND_DISPLAY", "DBUS_SESSION_BUS_ADDRESS", "SNAP",
        "PI_CODING_AGENT_DIR", "PI_CODING_AGENT_SESSION_DIR", "PI_OFFLINE",
        "CLAUDE_CONFIG_DIR", "CLAUDE_CODE_OAUTH_TOKEN", "CODEX_HOME", "CURSOR_API_KEY",
        "DEVIN_API_KEY", "DASHSCOPE_API_KEY", "FACTORY_API_KEY", "AMP_API_KEY",
        "GOOGLE_API_KEY", "GOOSE_PROVIDER", "GOOSE_MODEL",
        "GITHUB_TOKEN", "GH_TOKEN",
        "PIPI_ORCHESTRATOR_URL", "PIPI_ORCHESTRATOR_TOKEN", "PIPI_RUNTIME_MODE",
        "PIPI_AGENT_ID", "PIPI_IS_SUBAGENT",
        "ANTHROPIC_API_KEY", "ANTHROPIC_OAUTH_TOKEN", "ANTHROPIC_AUTH_TOKEN", "ANT_LING_API_KEY",
        "OPENAI_API_KEY", "DEEPSEEK_API_KEY", "NVIDIA_API_KEY", "GEMINI_API_KEY", "COPILOT_GITHUB_TOKEN",
        "MISTRAL_API_KEY", "GROQ_API_KEY", "CEREBRAS_API_KEY", "XAI_API_KEY", "OPENROUTER_API_KEY",
        "AI_GATEWAY_API_KEY", "ZAI_API_KEY", "ZAI_CODING_CN_API_KEY", "OPENCODE_API_KEY", "RADIUS_API_KEY",
        "TYPESAFE_API_KEY", "HF_TOKEN", "FIREWORKS_API_KEY", "TOGETHER_API_KEY", "BASETEN_API_KEY",
        "KIMI_API_KEY", "META_API_KEY", "MINIMAX_API_KEY", "MINIMAX_CN_API_KEY", "MOONSHOT_API_KEY",
        "QWEN_TOKEN_PLAN_API_KEY", "QWEN_TOKEN_PLAN_CN_API_KEY", "XIAOMI_API_KEY",
        "XIAOMI_TOKEN_PLAN_CN_API_KEY", "XIAOMI_TOKEN_PLAN_AMS_API_KEY", "XIAOMI_TOKEN_PLAN_SGP_API_KEY",
        "AZURE_OPENAI_API_KEY", "AZURE_OPENAI_BASE_URL", "AZURE_OPENAI_RESOURCE_NAME",
        "AZURE_OPENAI_DEPLOYMENT_NAME_MAP", "AZURE_OPENAI_API_VERSION",
        "AWS_PROFILE", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN",
        "AWS_BEARER_TOKEN_BEDROCK", "AWS_REGION", "AWS_DEFAULT_REGION",
        "CLOUDFLARE_API_KEY", "CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_GATEWAY_ID",
        "GOOGLE_CLOUD_API_KEY", "GOOGLE_CLOUD_PROJECT", "GCLOUD_PROJECT", "GOOGLE_CLOUD_LOCATION",
        "GOOGLE_APPLICATION_CREDENTIALS",
        "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY",
        "http_proxy", "https_proxy", "all_proxy", "no_proxy",
        "SHELL", "USER", "TERM"
      ]
    },
    "fs": {
      "read": ["${homeDir}", "${pluginDir}", "${dataDir}", "/"],
      "write": ["${homeDir}", "${dataDir}", "/"]
    },
    "clipboard": true,
    "openUrl": { "schemes": ["https", "http", "mailto"] }
  }
}
